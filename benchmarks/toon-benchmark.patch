+for (const q of qs) {
+  const d = ACCURACY_DATASETS.find(x => x.name === q.dataset)!
+  for (const n of names) {
+    if (n === 'csv' && !supportsCSV(d)) continue
+    perFormat[n] = (perFormat[n] ?? 0) + tokenize(encodeDataset(FORMATS[n]!, d)) + 120
+  }
+}
+console.log('\nestimated input tokens per model for a full run (data + ~120 tokens of prompt):')
