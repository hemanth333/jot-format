+
+const names = Object.keys(FORMATS)
+const totals: Record<string, number> = Object.fromEntries(names.map(n => [n, 0]))
+console.log('dataset'.padEnd(40) + names.map(n => n.padStart(13)).join(''))
+for (const d of ACCURACY_DATASETS) {
+  const row: string[] = []
+  for (const n of names) {
+    if (n === 'csv' && !supportsCSV(d)) { row.push('-'.padStart(13)); continue }
