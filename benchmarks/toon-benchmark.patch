+    if (n.startsWith('jot')) {
+      let verdict: string
+      try {
+        const back = JSON.parse(execFileSync(process.env.PYTHON ?? (process.platform === 'win32' ? 'python' : 'python3'), [JOT_PY_PATH, 'to-json', '-'], { input: text, encoding: 'utf8' }))
